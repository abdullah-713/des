# إعدادات قاعدة البيانات
DB_HOST=localhost
DB_NAME=attendance_system
DB_USER=your_database_username
DB_PASS=your_database_password

# إعدادات التطبيق
APP_NAME="صرح انضباط"
APP_ENV=production
APP_DEBUG=false

# إعدادات الأمان
SESSION_LIFETIME=30
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=password

# ملاحظة: قم بتغيير كلمة المرور الافتراضية فوراً بعد التثبيت!
